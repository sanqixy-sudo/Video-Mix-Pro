.env.*
!.env.example

# Python caches
__pycache__/
*.py[cod]
server/.test-venv/
server/.qa-data*/

# Release artifacts belong in GitHub Releases, not source control
release/

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.zip
*.7z
*.rar
