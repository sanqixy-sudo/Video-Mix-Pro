# Dependencies
node_modules/
.opencode/
.agents/
.venv/
**/.venv/
.pnpm-store/
.portable-build-tools/
.cargo-target/
.cargo-target-*/

# Frontend / Tauri build outputs
desktop/dist/
desktop/src-tauri/target/
desktop/src-tauri/gen/schemas/

# Runtime binaries downloaded locally
desktop/src-tauri/bin/ffmpeg.exe
